# Anthropic API key for the guide (src/pages/api/guide.ts).
#
# DO NOT commit a real key. The guide is BILLED per request against the
# Anthropic API — verify with build/check only, never by live-testing it.
# The persona (Alexander) and system prompt are finalised in
# src/lib/guide-prompt.ts; the endpoint returns 503 when this is unset.
#
# Leave this empty in the committed file. Set a real value only in Vercel
# project env (Preview/Production) or a local, git-ignored .env when the
# guide is intentionally ready to run.
ANTHROPIC_API_KEY=

# ——————————————————————————————————————————————————————————————————————————
# Pocket coach web push ("Tom in your pocket").
#
# Generate a VAPID keypair once:  npx web-push generate-vapid-keys
# Set all three in Vercel project env (Production). The PUBLIC key is served to
# the browser by /api/push/vapid; the PRIVATE key is the secret that signs sends.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tomcassidy@mac.com

# Cron auth — Vercel sends `Authorization: Bearer <CRON_SECRET>` to the cron
# endpoint when this is set, so only Vercel can trigger a send. Optional but
# recommended (any random string).
CRON_SECRET=

# The coach store — Supabase, the estate's existing backend. Both are required;
# without them /api/push/subscribe returns a real 503 and nobody is subscribed.
# The SERVICE ROLE key, not the anon key: the tables have RLS on with no
# policies, so only the service role can read them. A push endpoint plus its
# keys is a credential, which is why the anon key must never reach these rows.
# Schema: supabase/migrations/20260901_coach_subscribers.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ——————————————————————————————————————————————————————————————————————————
# MIGRATION ONLY — the three variables the solo-dogfood version used. The cron
# lifts PUSH_SUBSCRIPTION into coach_subscribers on its first run and then
# ignores them forever. REMOVE them from Vercel once that row is confirmed, and
# delete src/lib/coach-migrate.ts with them. PROGRAM_START_DATE takes epoch ms
# or an ISO date.
# PUSH_SUBSCRIPTION=
# PROGRAM_START_DATE=
# WEEKLY_GOAL=
