---
import { reasonableEating as program } from '@/lib/programs/reasonable-eating';
import { todaysFocus } from '@/lib/today';
import { focusForWeek, rotationOrder } from '@/lib/coach-engine';

// The everyday PRACTICE screen — and the page a push notification opens.
// It shows ONE thing: this week's focus. Computed fresh on each request so it
// always reflects the live calendar week, never a stale build.
export const prerender = false;

// The DEFAULT view, for somebody who has not switched the coach on: the
// rotation off Tom's own start date. A subscriber's view is not this — see
// below.
const { week, totalWeeks, focus, domain } = todaysFocus(program);

// Neither the goal NOR the week is settled server-side. Whose they are depends
// on which device is asking, and the server only learns that from the browser's
// own push subscription — so both load client-side, after the service-worker
// handshake below hands it an identity.
//
// A subscriber is on THEIR week, counted from THEIR start date, which is what
// the push that brought them here was computed from. Rendering Tom's week to
// them would contradict the notification they just tapped. The whole rotation
// ships to the client so the swap needs no second round trip: it is twelve
// short strings, and it is the same `rotationOrder` the cron sends off, so the
// page and the push cannot disagree about which focus it is.
const rotation = rotationOrder(program).map((w) => {
  const f = focusForWeek(program, w);
  const inDomain = program.domains.find((d) => d.focuses.some((x) => x.week === w));
  return f === 'hub'
    ? { week: w, name: program.hub.algorithmName, wisdom: program.hub.coach.wisdom, domain: '' }
    : { week: w, name: f.name, wisdom: f.coach.wisdom, domain: inDomain?.name ?? '' };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>This week · {program.title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#16140f" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Eating" />
  </head>
  <body>
    <main class="today">
      <p class="week" id="week-line">Week {week} of {totalWeeks}{domain ? ` · ${domain}` : ''}</p>
      <h1 class="focus" id="focus-name">{focus.name}</h1>
      <p class="line" id="focus-wisdom">{focus.coach.wisdom}</p>

      <!--
        One thing, one week, your words. Three states, and the middle one is the
        point: we show back exactly what we heard, and nothing is ever pushed
        until you've confirmed it's actually what you said.
      -->
      <section class="goal" id="goal" data-state="loading">
        <p class="goal-loading" id="goal-loading">Finding your one thing…</p>

        <div class="goal-off" id="goal-off" hidden>
          <p class="goal-label">Your one thing this week</p>
          <p class="line">
            Turn the coach on first — tap <a href="/reasonable-eating">🔔 Tom in your pocket</a> on
            the programme page, and this is where your one thing lives.
          </p>
        </div>

        <form class="goal-set" id="goal-set" hidden>
          <label class="goal-label" for="goal-text">Your one thing this week</label>
          <textarea
            id="goal-text"
            name="text"
            rows="2"
            maxlength="280"
            placeholder="Say it the way you'd say it."
            enterkeyhint="done"></textarea>
          <button type="submit" class="goal-btn">Set it</button>
        </form>

        <div class="goal-confirm" id="goal-confirm" hidden>
          <p class="goal-label">Is this exactly what you said?</p>
          <blockquote class="goal-text" id="goal-echo"></blockquote>
          <div class="goal-row">
            <button type="button" class="goal-btn" id="goal-bless">Yes, that's it</button>
            <button type="button" class="goal-link" id="goal-redo">No — say it again</button>
          </div>
        </div>

        <div class="goal-done" id="goal-done" hidden>
          <p class="goal-label">Your one thing this week</p>
          <blockquote class="goal-text" id="goal-blessed"></blockquote>
          <button type="button" class="goal-link" id="goal-change">Change it</button>
        </div>

        <p class="goal-status" id="goal-status" hidden></p>
      </section>
    </main>

    <script type="application/json" id="rotation" is:inline set:html={JSON.stringify(rotation)}></script>

    <script>
      // The blessed-confirmation loop. `set` stores the text unblessed; `bless`
      // confirms the server's copy without re-sending any text, so what you
      // confirmed and what gets pushed cannot drift apart.
      //
      // Identity comes from this device's own push subscription: the server
      // hashes the endpoint to an id, so every call has to carry the endpoint
      // and nothing works until the coach is switched on.
      (function () {
        const root = document.getElementById('goal');
        const setForm = document.getElementById('goal-set') as HTMLFormElement | null;
        const confirmBox = document.getElementById('goal-confirm');
        const doneBox = document.getElementById('goal-done');
        const offBox = document.getElementById('goal-off');
        const loading = document.getElementById('goal-loading');
        const field = document.getElementById('goal-text') as HTMLTextAreaElement | null;
        const echo = document.getElementById('goal-echo');
        const blessedOut = document.getElementById('goal-blessed');
        const status = document.getElementById('goal-status');
        if (!root || !setForm || !confirmBox || !doneBox || !field) return;

        let endpoint: string | null = null;

        /**
         * Put this page on the VIEWER's week, not Tom's.
         *
         * `weekIndex` is the absolute ordinal the server counted from their own
         * start date — the very number the push was built from — so indexing
         * the rotation with it is the same arithmetic `currentWeekNumber` runs
         * server-side. Anyone who has not switched the coach on keeps the
         * server-rendered default, which is the rotation off Tom's start.
         */
        function showWeek(weekIndex: number) {
          const holder = document.getElementById('rotation');
          if (!holder?.textContent) return;
          let rotation: { week: number; name: string; wisdom: string; domain: string }[];
          try {
            rotation = JSON.parse(holder.textContent);
          } catch {
            return;
          }
          if (!rotation.length || !Number.isFinite(weekIndex) || weekIndex < 0) return;

          const slot = rotation[weekIndex % rotation.length];
          const weekLine = document.getElementById('week-line');
          const nameOut = document.getElementById('focus-name');
          const wisdomOut = document.getElementById('focus-wisdom');
          if (weekLine) {
            weekLine.textContent =
              `Week ${slot.week} of ${rotation.length}` + (slot.domain ? ` · ${slot.domain}` : '');
          }
          if (nameOut) nameOut.textContent = slot.name;
          if (wisdomOut) wisdomOut.textContent = slot.wisdom;
        }

        function say(msg: string) {
          if (!status) return;
          status.textContent = msg;
          status.hidden = !msg;
        }

        function show(state: 'loading' | 'off' | 'empty' | 'unblessed' | 'blessed') {
          root!.dataset.state = state;
          if (loading) loading.hidden = state !== 'loading';
          if (offBox) offBox.hidden = state !== 'off';
          setForm!.hidden = state !== 'empty';
          confirmBox!.hidden = state !== 'unblessed';
          doneBox!.hidden = state !== 'blessed';
        }

        async function post(payload: Record<string, unknown>) {
          const res = await fetch('/api/push/goal', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...payload, endpoint }),
          });
          const out = await res.json().catch(() => ({}) as any);
          // Only treat it as saved when the server says it saved.
          if (!res.ok || !out.ok) throw new Error(out.error || 'That didn’t save.');
          say('');
          return out;
        }

        setForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const text = field.value.trim();
          if (!text) return;
          try {
            const out = await post({ action: 'set', text });
            if (echo) echo.textContent = out.goal.text;
            show('unblessed');
          } catch (err) {
            say((err as Error).message);
          }
        });

        document.getElementById('goal-bless')?.addEventListener('click', async () => {
          try {
            const out = await post({ action: 'bless' });
            if (blessedOut) blessedOut.textContent = out.goal.text;
            show('blessed');
          } catch (err) {
            say((err as Error).message);
          }
        });

        document.getElementById('goal-redo')?.addEventListener('click', () => {
          field.value = echo?.textContent ?? '';
          show('empty');
          field.focus();
        });

        document.getElementById('goal-change')?.addEventListener('click', () => {
          field.value = blessedOut?.textContent ?? '';
          show('empty');
          field.focus();
        });

        // The handshake: this device's push endpoint IS the identity. No
        // subscription means there is nobody to be, so we say so rather than
        // showing a box that cannot save.
        (async function load() {
          try {
            if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
              show('off');
              return;
            }
            // `serviceWorker.ready` never resolves when nothing is registered
            // for this scope, so it gets a deadline rather than a spinner that
            // hangs forever.
            const reg = await Promise.race([
              navigator.serviceWorker.ready,
              new Promise<null>((r) => setTimeout(() => r(null), 3000)),
            ]);
            if (!reg) {
              show('off');
              return;
            }
            const sub = await reg.pushManager.getSubscription();
            if (!sub) {
              show('off');
              return;
            }
            endpoint = sub.endpoint;
            const res = await fetch(`/api/push/goal?endpoint=${encodeURIComponent(endpoint)}`);
            const out = await res.json().catch(() => ({}) as any);
            if (res.status === 404) {
              // Subscribed in this browser, but the server has no row — the
              // subscription never landed. Send them back to the bell.
              show('off');
              return;
            }
            if (!res.ok) {
              show('off');
              say(out.error || 'Couldn’t reach the coach just now.');
              return;
            }
            // Their week arrives with their goal, off the same row — so the
            // heading stops being Tom's before the goal box paints.
            if (typeof out.weekIndex === 'number') showWeek(out.weekIndex);

            const goal = out.goal;
            if (!goal) {
              show('empty');
            } else if (goal.blessed) {
              if (blessedOut) blessedOut.textContent = goal.text;
              show('blessed');
            } else {
              if (echo) echo.textContent = goal.text;
              show('unblessed');
            }
          } catch {
            show('off');
          }
        })();
      })();
    </script>

    <style>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        height: 100%;
        background: #16140f;
        color: #f3efe6;
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        -webkit-font-smoothing: antialiased;
      }
      .today {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
        max-width: 34rem;
        margin: 0 auto;
        padding: 2rem 1.75rem calc(2rem + env(safe-area-inset-bottom));
        box-sizing: border-box;
      }
      .week {
        margin: 0;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #a39b86;
      }
      .focus {
        margin: 0;
        font-size: clamp(2.4rem, 9vw, 3.6rem);
        line-height: 1.05;
        font-weight: 500;
        letter-spacing: -0.01em;
      }
      .line {
        margin: 0;
        font-size: clamp(1.15rem, 4.5vw, 1.4rem);
        line-height: 1.5;
        color: #d8d2c4;
      }

      .goal {
        border-top: 1px solid #302c24;
        padding-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .goal-label {
        margin: 0 0 0.6rem;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #a39b86;
      }
      .goal-set {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .goal textarea {
        width: 100%;
        box-sizing: border-box;
        background: #1e1b15;
        color: #f3efe6;
        border: 1px solid #3a352b;
        border-radius: 0.5rem;
        padding: 0.75rem;
        font: inherit;
        font-size: 1.05rem;
        line-height: 1.4;
        resize: vertical;
      }
      .goal textarea:focus {
        outline: none;
        border-color: #6f6552;
      }
      .goal-text {
        margin: 0 0 0.9rem;
        padding-left: 0.9rem;
        border-left: 2px solid #6f6552;
        font-size: clamp(1.1rem, 4.2vw, 1.3rem);
        line-height: 1.45;
        color: #f3efe6;
      }
      .goal-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .goal-btn {
        margin-top: 0.75rem;
        background: #f3efe6;
        color: #16140f;
        border: 0;
        border-radius: 999px;
        padding: 0.6rem 1.3rem;
        font: inherit;
        font-size: 0.95rem;
        cursor: pointer;
      }
      .goal-row .goal-btn {
        margin-top: 0;
      }
      .goal-link {
        background: none;
        border: 0;
        padding: 0;
        font: inherit;
        font-size: 0.9rem;
        color: #a39b86;
        text-decoration: underline;
        cursor: pointer;
      }
      .goal-loading {
        margin: 0;
        font-size: 0.9rem;
        color: #a39b86;
      }
      .goal-off .line {
        font-size: 1rem;
        color: #d8d2c4;
      }
      .goal-off a {
        color: #f3efe6;
      }
      .goal-status {
        margin: 0;
        font-size: 0.85rem;
        color: #c9a86a;
      }
    </style>
  </body>
</html>
