<script>
  // Fetch Tania's real schools from her open WordPress REST API and fill the
  // mockups. On any failure the neutral placeholders simply remain.
  const IDS = [
    7113, 7116, 7134, 7137, 7166, 7169, 7175, 7197, 7204, 7098, 6499, 6493, 6602, 8264,
    8273, 8570, 8660, 8978,
  ];
  const API =
    'https://dreamtravelstudy.com/wp-json/wp/v2/school?per_page=20&_embed=wp:featuredmedia,wp:term&include=' +
    IDS.join(',');

  const decode = (s: string) => {
    const el = document.createElement('textarea');
    el.innerHTML = s;
    return el.value;
  };

  interface School {
    name: string;
    img: string;
    loc: string;
    age: string;
    cur: string;
  }

  function parseSchool(raw: any): School {
    const media = raw?._embedded?.['wp:featuredmedia']?.[0];
    const groups: any[][] = raw?._embedded?.['wp:term'] ?? [];
    const by: Record<string, string[]> = {};
    for (const group of groups) {
      for (const t of group ?? []) {
        if (typeof t?.name === 'string' && !t.name.startsWith('#')) {
          (by[t.taxonomy] ??= []).push(decode(t.name));
        }
      }
    }
    const country = by.school_country?.[0] ?? '';
    const city = (by.region ?? []).find((r) => r !== country) ?? '';
    return {
      name: decode(raw?.title?.rendered ?? ''),
      img: media?.source_url ?? '',
      loc: [city, country].filter(Boolean).join(', '),
      age: (by.age?.[0] ?? '').replace('Age:', 'Ages'),
      cur: (by.curriculum ?? []).slice(0, 2).join(' · '),
    };
  }

  function fill(schools: Map<number, School>) {
    document.querySelectorAll<HTMLElement>('.showcase [data-sid]').forEach((slot) => {
      const s = schools.get(Number(slot.dataset.sid));
      if (!s || !s.name) return;
      slot.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => {
        const field = el.dataset.f as keyof School;
        if (field === 'img') {
          if (!s.img) return;
          const img = new Image();
          img.loading = 'lazy';
          img.decoding = 'async';
          img.alt = s.name;
          img.src = s.img;
          img.addEventListener('load', () => el.classList.add('ph-loaded'));
          el.appendChild(img);
        } else if (s[field]) {
          el.textContent = s[field];
        }
      });
    });
  }

  fetch(API)
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .then((list: any[]) => {
      const schools = new Map<number, School>();
      for (const raw of list) schools.set(raw.id, parseSchool(raw));
      fill(schools);
    })
    .catch(() => {
      /* placeholders remain — composed, neutral, never broken */
    });

  // "This is the one" — compose a message for Tania to send Tom, with no
  // backend: the phone's own share sheet, falling back to the clipboard.
  document.querySelectorAll<HTMLButtonElement>('.choose-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = `Tom — of the three designs, I like "${btn.dataset.choice}" best.`;
      try {
        if (navigator.share) {
          await navigator.share({ text });
          btn.textContent = 'Sent ✓';
          return;
        }
        throw new Error('no share');
      } catch {
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied — paste it to Tom';
        } catch {
          btn.textContent = `Tell Tom: ${btn.dataset.choice}`;
        }
      }
    });
  });
</script>

